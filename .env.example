# Copy to .env and enter NEW credentials after rotating any exposed key
BITOPRO_API_KEY=YOUR_NEW_API_KEY
BITOPRO_API_SECRET=YOUR_NEW_API_SECRET
BITOPRO_EMAIL=YOUR_ACCOUNT_EMAIL

# Safety: leave live trading disabled until you've tested
LIVE_TRADING=false
PORT=3001

# Approximate maker fee rate; observed example is about 0.01% (confirm your account tier)
FEE_RATE=0.0001
